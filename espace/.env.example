# Serveur de l'outil d'analyse : variables d'environnement (AUCUN secret réel dans le dépôt).
# Fichier réel : /etc/mpb/outil-analyse.env, propriétaire root, droits 600.

APP_ORIGIN=https://bilan.monphotographebebe.fr
MPB_PRO_ORIGIN=https://pro.monphotographebebe.fr
MPB_CLIENT_ID=espace-visibilite
# Même secret que MPB_REMOTE_CLIENT_SECRET côté Pro (openssl rand -hex 32), installé sur les deux serveurs seulement
MPB_CLIENT_SECRET=
MPB_REDIRECT_URI=https://bilan.monphotographebebe.fr/auth/callback

# Stockage partagé des sessions et des transactions SSO, et accès métier : URL Postgres du projet Supabase
# (Supabase > Project Settings > Database > Connection string, mode « Session pooler », port 5432, sslmode=require)
SESSION_STORE_URL=
# Certificat racine Supabase (à télécharger dans Project Settings > Database > SSL Configuration), monté dans le conteneur
SESSION_STORE_CA=/etc/mpb/supabase-ca.crt
# Clé de chiffrement des jetons au repos : 32 octets (openssl rand -hex 32). Différente du secret client.
SESSION_ENCRYPTION_KEY=

# Projet Supabase (Edge Functions appelées par le serveur avec le jeton MPB)
SUPABASE_URL=https://htyvaqxdfptgswvwqplq.supabase.co
# Le serveur n'utilise pas la clé service_role (accès Postgres direct) : ne pas la fournir.

# Facultatif
# PORT=8080
# MPB_TIMEOUT_MS=6000            délai maximum des appels au Pro
# FUNCTIONS_TIMEOUT_MS=180000    délai maximum des Edge Functions
# TRUST_PROXY=172.17.0.1            adresse du Nginx vu depuis le conteneur (pour lire X-Forwarded-For)
# MPB_LIMITE_CONNEXIONS=30         démarrages de connexion par minute et par adresse
# CSP_IMG_ORIGINS=https://www.monphotographebebe.fr   origines d'images en plus du Pro (logo, fiches Parents)
